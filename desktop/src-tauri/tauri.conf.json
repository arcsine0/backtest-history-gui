{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stratara",
  "version": "0.1.0",
  "identifier": "com.raphael.stratara",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "features": ["pytauri/standalone"]
  },
  "app": {
    "windows": [
      {
        "title": "Stratara",
        "width": 1280,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/backtest-studio-symbol-v5.png",
      "icons/icon.ico"
    ]
  }
}
